# SKYCOT web - env vars
#
# Copy to `.env.local` for development. Production deployments set
# these in the host secret store or Vercel project settings.

# Deployment mode. Production disables mock fallbacks in gateway clients.
NEXT_PUBLIC_ENV=development

# URL of the SKYCOT gateway. Production: https://api.skycot.com.
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:7400

# Compatibility alias for deployment tooling that calls the gateway API URL.
# Keep it equal to NEXT_PUBLIC_GATEWAY_URL unless a future API proxy is added.
NEXT_PUBLIC_API_URL=http://127.0.0.1:7400

# Browser-visible dev auth bypass for local/demo runs. NEVER set in
# staging or production; the middleware enforces this at runtime
# (process.env.NODE_ENV !== "production").
NEXT_PUBLIC_ARGO_GATEWAY_AUTH_BYPASS=0

# Surfaces the "Or try a demo workspace" secondary button on
# /auth/signup. Defaults to visible whenever NEXT_PUBLIC_ENV is not
# "production"; set to "1" to force-enable on a preview deploy, or
# leave unset (or "0") on production to keep the demo bypass hidden.
NEXT_PUBLIC_ALLOW_DEMO_MINT=0

# Full demo-recording mode for the v1.0 mp4 capture: replaces the
# magic-link form on /auth/signup with a single "Enter demo
# workspace" button. Paired with the gateway flag ARGO_DEMO_MODE=1;
# without both, the demo-mint route returns 404. NEVER set in
# production.
NEXT_PUBLIC_ARGO_DEMO_MODE=0

# Recording-mode opt-out from the SPA's mock-bypass short-circuits.
# When set to "1" alongside NEXT_PUBLIC_ARGO_GATEWAY_AUTH_BYPASS=1 +
# NEXT_PUBLIC_ARGO_DEMO_MODE=1, the audit feed, audit drill-in,
# replay, and approval-decide buttons stop returning the bundled
# SAMPLE_* constants and instead fire real gateway round-trips
# (GET /api/v1/audit, GET /api/v1/audit/<id>, POST /api/v1/audit/<id>
# /replay, POST /api/v1/approvals/<id>/decide). Use during v1.0 MP4
# recording so Scene 6's "real provenance" narration is truthful.
# Requires `argo demo seed --tenant <demo>` to have run against the
# live gateway, otherwise the audit feed renders empty. Leave 0 for
# fast local UI iteration where the mock layer is the point.
NEXT_PUBLIC_SKYCOT_DEMO_LIVE=0

# SPA-side demo flag. When "1", the SPA renders seeded mock data
# ("Sam Harlow · Acmeco · Owner", six fake teammates, fifteen audit
# rows) for the v1.0 recorded demo and the sidebar footer carries a
# purple "Demo mode" stamp. When "0" (or unset) the SPA reads real
# session identity from NextAuth, real workspace data from the
# gateway, and the sidebar footer carries a green "Live mode" stamp.
# `NEXT_PUBLIC_*` env vars are inlined at build time — flipping this
# requires a dev-server restart for the new value to take effect.
NEXT_PUBLIC_SKYCOT_DEMO_MODE=0

# Dev-only diagnostic — re-enables the "LIVE" / "MOCK (OFFLINE)" /
# "MOCK (AUTH-BYPASS)" pill next to the /team and /approvals page
# headings. Hidden by default in every build because the chip leaked
# onto camera during the v1.0 demo MP4 recording (the gateway 404'd
# a not-yet-wired endpoint, the page fell through to mock data, and
# the chip read "broken software" to an investor). The underlying
# value stays inspectable via a `data-source` attribute on the
# page-header wrapper regardless of this flag.
NEXT_PUBLIC_SKYCOT_SHOW_DATA_SOURCE_CHIP=0

# Stripe publishable key for hosted signup / billing UI. Safe to expose.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Required by NextAuth v5 — a 32-byte secret used to sign JWT
# sessions. Generate with: `openssl rand -base64 32`.
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# The public URL the SPA is served from. NextAuth uses it to build
# callback URLs. Production: https://app.skycot.com.
NEXTAUTH_URL=http://localhost:3000
