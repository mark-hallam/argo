# syntax=docker/dockerfile:1
# SKYCOT SPA (Next.js) — standalone-output runtime image.
#
# The web project uses pnpm (web/pnpm-lock.yaml + "packageManager": "pnpm@10").
# corepack pins the right pnpm version from package.json.
#
# Demo-mode flags are baked at BUILD time (NEXT_PUBLIC_* are build-time in
# Next). DEMO_MODE + DEMO_LIVE => the SPA fetches REAL seeded gateway data (no
# mock, no dev-overlay). The browser uses SAME-ORIGIN relative paths that nginx
# routes to the loopback gateway, so NEXT_PUBLIC_GATEWAY_URL is only the
# build-time CSP/Next-proxy origin, never a URL the browser dials cross-origin.
# BUT: this image sets NODE_ENV=production, so the prebuild guard
# (web/scripts/check-canonical-gateway-port.mjs) runs in --strict mode and
# REQUIRES an HTTPS, non-localhost NEXT_PUBLIC_GATEWAY_URL (it rejects unset +
# localhost). So default it to the gated-preview public origin; override via
# --build-arg NEXT_PUBLIC_GATEWAY_URL=https://<your-domain> for a different host.

# ---- builder ----
# `--platform=$BUILDPLATFORM`: run the Next build on the HOST's native arch.
# On an Apple-Silicon host targeting `--platform linux/amd64`, this keeps the
# `pnpm run build` (SWC, a native Rust compiler) on arm64 instead of running it
# under amd64 QEMU emulation, which segfaults (`qemu: uncaught target signal 11`)
# during `next build`. The runtime stage below stays on the TARGET platform
# (amd64 for App Runner). The Next standalone output is pure JS (no native
# runtime deps in this app), so the arm64-built output runs unchanged on amd64.
# On an x86 builder (e.g. CodeBuild) $BUILDPLATFORM == the target, so this is a
# no-op there.
FROM --platform=$BUILDPLATFORM node:20-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable
# Lockfile-first install for layer caching; pnpm picks its version from
# package.json's "packageManager" field via corepack.
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
ARG NEXT_PUBLIC_SKYCOT_DEMO_MODE=1
ARG NEXT_PUBLIC_SKYCOT_DEMO_LIVE=1
ARG NEXT_PUBLIC_GATEWAY_URL=https://try.skycot.com
# Stripe price ids are build-time public env (NEXT_PUBLIC_*). The SPA reads
# NEXT_PUBLIC_STRIPE_PRICE_PRO / _ENTERPRISE (app/pricing/page.tsx,
# app/(app)/billing/subscribe/page.tsx) and POSTs the id to the gateway billing
# route (server-side Checkout — no browser Stripe.js / publishable key). Docker
# DROPS a --build-arg whose ARG is not declared, so without these two ARG+ENV
# lines a real (non-demo) build ships with "No Stripe price configured" and the
# upgrade/pay flow is dead. Default empty = the demo build is unaffected.
ARG NEXT_PUBLIC_STRIPE_PRICE_PRO=
ARG NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=
ENV NODE_ENV=production \
    NEXT_PUBLIC_SKYCOT_DEMO_MODE=${NEXT_PUBLIC_SKYCOT_DEMO_MODE} \
    NEXT_PUBLIC_SKYCOT_DEMO_LIVE=${NEXT_PUBLIC_SKYCOT_DEMO_LIVE} \
    NEXT_PUBLIC_GATEWAY_URL=${NEXT_PUBLIC_GATEWAY_URL} \
    NEXT_PUBLIC_STRIPE_PRICE_PRO=${NEXT_PUBLIC_STRIPE_PRICE_PRO} \
    NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=${NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE}
RUN pnpm run build
# REFINE-ON-DEPLOY (DEPLOYMENT.md #6): confirm the prod SPA renders the seeded
# demo without a login wall. isAuthBypassed() is FALSE in a production build
# (it's NODE_ENV!=="production"-gated), so the app relies on demo-mode (not
# auth-bypass) to show pages + fetch real data. The nginx gate is the privacy
# boundary; demo-mode is the data path.

# ---- runtime ----
FROM node:20-bookworm-slim AS runtime
WORKDIR /app
# HOSTNAME=0.0.0.0: Next standalone server.js binds to $HOSTNAME. 127.0.0.1 makes
# the container reachable only from inside itself, so any out-of-container front
# door (App Runner health check + inbound, an ALB target group, a sibling nginx
# container) cannot reach it and the service never goes healthy. 0.0.0.0 binds all
# interfaces — correct behind App Runner/ALB/nginx alike; the container network
# (not the bind addr) is the isolation boundary. The old 127.0.0.1 only worked for
# a same-container/same-pod loopback proxy, which the split topology does not use.
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
# Next standalone output is self-contained (Next traces + copies the real dep
# files, so pnpm's symlinked store does not need to ship). Static assets +
# public/ sit beside the server.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
# Non-root runtime user (uid/gid 10001, "app"). The SPA writes no persistent
# volume, so no chown is needed; PORT 3000 is > 1024 so no privileged-port cap
# is needed. USER goes AFTER the COPYs so the static output lands root-readable.
RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -m -s /usr/sbin/nologin app
EXPOSE 3000
USER 10001
CMD ["node", "server.js"]
