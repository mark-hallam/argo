# SKYCOT — canonical PRODUCTION secret + config reference.
#
# This is the SINGLE code-grounded list of everything a production gateway
# deploy needs. Every var name here was verified against the crate that reads it
# (citations inline). Copy to `skycot-production.env`, fill in, `chmod 600`,
# and NEVER commit the filled copy.
#
# Where these values go depends on the deploy path:
#   - AWS (operative v1 path): set via AWS Secrets Manager — see
#     docs/skycot/deploy/AWS_DEPLOY_RUNBOOK.md §6. The terraform under
#     infra/terraform/ creates the secret resources; you populate the values.
#   - docker-compose / VM: inject this .env directly into the gateway container.
#
# This file supersedes the PARTIAL templates for the full production set:
#   - deploy/.env.deploy.example        (VM + compose path; missing JWT + master key + stripe)
#   - deploy/flyio/secrets.example.sh   (Fly path; uses the WRONG name JWT_SIGNING_KEY —
#                                         the code reads SKYCOT_AUTH_JWT_SECRET)

# =============================================================================
# 1. GATEWAY RUNTIME SECRETS + CONFIG  (the gateway process reads these)
# =============================================================================

# --- Production profile (config, not secret, but LOAD-BEARING) ---
# Forces gateway.auth_bypass OFF and requires a bearer token. Verified:
# routes_auth.rs:58-87 (bypass honored only when !production) +
# routes_auth_production_mode.rs:30-32 (profile=production => production mode) +
# boot.rs:123-129 (production + missing bearer => refuse to boot).
ARGO_GATEWAY_PROFILE=production

# Persistent data dir (the SQLite store + workspace state live here; the AWS
# deploy mounts EFS at /data).
ARGO_HOME=/data

# --- Bearer token (REQUIRED in production) ---
# The admin bearer for non-loopback bind. Without it the gateway fails closed
# at boot in production. Generate: openssl rand -hex 32
# Verified: routes_auth_production_mode.rs:13 (BEARER_TOKEN_ENV).
ARGO_GATEWAY_BEARER_TOKEN=

# --- Session JWT secret (REQUIRED in production) ---
# HMAC secret for the __Host-session cookie JWTs. If unset, the gateway mints an
# EPHEMERAL key (every restart invalidates all sessions). Generate: openssl rand -base64 48
# Verified: middleware_session_verify.rs:53 (SECRET_ENV = "SKYCOT_AUTH_JWT_SECRET").
SKYCOT_AUTH_JWT_SECRET=

# --- Credential master key (REQUIRED — else provider-key save 503s) ---
# Wraps per-tenant secrets (provider API keys, channel tokens). Set ONE of these
# (the binary accepts either name). Generate: openssl rand -base64 32
# Verified: argo-credentials/src/master_key.rs:55 (ARGO_CREDENTIALS_MASTER_KEY) +
# routes_onboarding_helpers.rs:407-408 (SKYCOT_WORKSPACE_ROOT_KEY_BASE64).
SKYCOT_WORKSPACE_ROOT_KEY_BASE64=
# ARGO_CREDENTIALS_MASTER_KEY=   # alternative name for the same key

# --- DB at-rest encryption key (REQUIRED in production) ---
# SQLCipher key for the encrypted SQLite store. Generate: openssl rand -base64 32
# Verified: argo-store/src/store_open.rs:32 (DB_KEY_ENV = "SKYCOT_DB_KEY_BASE64").
#
# ⚠️  PRODUCTION BOOT PREREQUISITE: the enterprise-encryption gate
# (store_open.rs:238 enforce_enterprise_encryption) fails closed in production
# UNLESS (a) the image was built with `--features bundled-sqlcipher` AND (b) this
# key is set. The stock root Dockerfile build does NOT enable the feature — see
# the runbook's "SQLCipher build" prerequisite. A stock build + production mode
# = the gateway REFUSES TO BOOT.
SKYCOT_DB_KEY_BASE64=

# --- Stripe billing (REQUIRED for paid tiers) ---
# Verified: argo-billing/src/stripe_client.rs:17 + :19.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_BASE_URL=               # optional; override only for Stripe test mode

# --- Platform LLM provider keys (OPTIONAL) ---
# The platform's OWN keys for Genesis authoring / voice / pitch. Per-TENANT
# provider keys are stored encrypted at runtime (master key above), NOT here.
# Free tier stays on the mock provider regardless (see WS5-4).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Public base URL (REQUIRED in production for correct sign-in links) ---
# The public origin the SPA is served from. Magic-link + workspace-invite
# emails mint their links against this. If UNSET, the gateway falls back to the
# hardcoded https://app.skycot.com and logs a loud startup WARNING — any deploy
# on a different host then emails links that point at the WRONG host.
# Verified: auth_magic_link_delivery.rs (public_base_url) +
# routes_workspace_members_invite.rs + startup_check.rs (warn_public_base_url_unset).
SKYCOT_PUBLIC_BASE_URL=https://app.skycot.com

# --- Outbound transactional email (REQUIRED to actually deliver sign-in links) ---
# Default provider is "noop": the gateway only LOGS the magic link and the signup
# response honestly reports status="not_configured" (the SPA shows an "email not
# set up" state). To deliver real email, set provider + credentials below.
#
# AWS SES is the v1 path (provider=smtp against email-smtp.<region>.amazonaws.com).
# Generate the SMTP username/password in the SES console (Account dashboard ->
# SMTP settings -> Create SMTP credentials). The password is a SECRET — in the AWS
# deploy it goes through Secrets Manager (key `smtp_password`), NOT this plaintext
# file. Verified: auth_magic_link_delivery.rs (apply_env_overrides) +
# email_outbound.rs (send_smtp, mandatory TLS).
#
# provider in { noop, postmark, sendgrid, smtp }
SKYCOT_EMAIL_PROVIDER=noop
SKYCOT_EMAIL_FROM_ADDRESS=noreply@skycot.com
# --- SMTP / SES (provider=smtp) ---
SKYCOT_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SKYCOT_SMTP_PORT=587
SKYCOT_SMTP_USERNAME=
SKYCOT_SMTP_PASSWORD=
# --- API providers (alternatives to SMTP) ---
# SKYCOT_POSTMARK_TOKEN=          # provider=postmark
# SKYCOT_SENDGRID_API_KEY=        # provider=sendgrid

# =============================================================================
# 2. SPA BUILD-TIME PUBLIC CONFIG  (baked into the Next.js build — NOT secret)
# =============================================================================
# These are NEXT_PUBLIC_* — they ship to the browser by design. Set them in the
# SPA build env (Vercel project env / docker build-args), not in the gateway.

# Browser-visible gateway URL.
# NEXT_PUBLIC_GATEWAY_URL=https://api.skycot.com

# Stripe Pro price id. The SPA POSTs this in the checkout body; the gateway reads
# it from the request, NOT from its own env. Verified: web/app/pricing/page.tsx:218
# (NEXT_PUBLIC_STRIPE_PRICE_PRO) + web/lib/billing/use-checkout.ts (price_id body).
# Create the Stripe product/price matching the `pro` slug in
# docs/skycot/pricing/v1-tiers.toml, then put its price_… id here.
# NEXT_PUBLIC_STRIPE_PRICE_PRO=price_xxx

# Demo/mock bypass MUST be OFF for a public build. A production Next.js build
# (NODE_ENV=production) already ignores the bypass, but set these to be explicit.
# NEXT_PUBLIC_ARGO_GATEWAY_AUTH_BYPASS=0
