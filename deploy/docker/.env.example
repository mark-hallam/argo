# Copy to .env and fill in real values before `docker-compose up`.
#
#   cp deploy/docker/.env.example deploy/docker/.env
#
# Required vars have no default. Compose will refuse to start without them.

# ---- required ----

# Bearer token for the gateway. Generate via `openssl rand -hex 32`.
# The example value below is NOT production-safe — replace it.
ARGO_GATEWAY_BEARER_TOKEN=dev-only-bearer-token-replace-me

# Postgres password. MUST match the password embedded in DATABASE_URL below.
# Change both together when rotating.
POSTGRES_PASSWORD=CHANGEME

# ---- optional (sensible defaults) ----

# Argo's database connection string. Postgres is included in the compose
# stack for forward-compatibility; argo today persists to SQLite under
# /data (the `argo-data` volume). Leave as-is unless you know you need to
# point at an external postgres.
DATABASE_URL=postgres://argo:CHANGEME@postgres:5432/argo

# Browser-visible gateway URL the SPA talks to. On the compose network the
# web container reaches argo via the service name `argo` on port 8080.
NEXT_PUBLIC_GATEWAY_URL=http://argo:8080

# Default tenant id for unscoped requests.
ARGO_TENANT_DEFAULT=default

# Log verbosity: trace | debug | info | warn | error.
ARGO_LOG_LEVEL=info

# ---- optional provider keys (only needed for live runs) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
