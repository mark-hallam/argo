{
  "uid": "skycot-provider-spend",
  "title": "SKYCOT — Provider spend",
  "tags": ["skycot", "providers", "spend"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "query": "label_values(provider_cost_micros_total, tenant_id)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spend last hour (USD)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(provider_cost_micros_total{tenant_id=~\"$tenant\"}[1h])) / 1e6"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spend per tenant (USD/hr)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id) (rate(provider_cost_micros_total{tenant_id=~\"$tenant\"}[5m])) * 3600 / 1e6",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Provider call rate by outcome",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, status) (rate(provider_call_total[1m]))",
          "legendFormat": "{{provider}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Provider p99 latency",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (provider, le) (rate(provider_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    }
  ]
}
