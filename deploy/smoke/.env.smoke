# CI-ONLY env for the K5 deploy smoke test.
# DO NOT use in production — auth bypass is enabled.
#
# Consumed by `deploy/smoke/run.sh` via `docker-compose --env-file`.
# Overrides `deploy/docker/.env.example`; see deploy/smoke/README.md.

ARGO_GATEWAY_BEARER_TOKEN=ci-smoke-test-token-do-not-use-in-prod
ARGO_GATEWAY_AUTH_BYPASS=1
ARGO_TENANT_DEFAULT=smoke-test
ARGO_LOG_LEVEL=info

# Placeholder provider key. The gateway's startup health-check (startup_check.rs
# provider_key_present) refuses to bind without ANTHROPIC_API_KEY or OPENAI_API_KEY
# set. The smoke makes NO LLM calls (checks.ts hits /health, /, /api/v1/workers,
# /inbox/approve, /metrics only), so a non-empty placeholder satisfies the presence
# check while the REAL store-open + schema-migration boot checks still run. NOT a
# real credential. A real key in the shell env overrides this for substitution.
ANTHROPIC_API_KEY=sk-smoke-placeholder-no-llm-calls-made

POSTGRES_PASSWORD=smoke
DATABASE_URL=postgres://argo:smoke@postgres:5432/argo_smoke

NEXT_PUBLIC_GATEWAY_URL=http://argo:8080

# CI-ONLY throwaway SQLCipher DB key (base64 of 32 random bytes). Production
# mode mandates an encrypted-at-rest store; the boot guard fails closed without
# a SQLCipher-linked binary + a non-none key_source. effective_key_source()
# synthesizes env:SKYCOT_DB_KEY_BASE64 when this is set. NOT a production secret
# — the smoke DB is ephemeral (compose down -v). Prod uses a real key_source.
SKYCOT_DB_KEY_BASE64=0aLwMC0XxC0QBNv4OkcERcd453LiFueVMeORBnG1W+Y=
