# CI-ONLY env for the K5 deploy smoke test.
# DO NOT use in production — auth bypass is enabled.
#
# Consumed by `deploy/smoke/run.sh` via `docker-compose --env-file`.
# Overrides `deploy/docker/.env.example`; see deploy/smoke/README.md.

ARGO_GATEWAY_BEARER_TOKEN=ci-smoke-test-token-do-not-use-in-prod
ARGO_GATEWAY_AUTH_BYPASS=1
ARGO_TENANT_DEFAULT=smoke-test
ARGO_LOG_LEVEL=info

POSTGRES_PASSWORD=smoke
DATABASE_URL=postgres://argo:smoke@postgres:5432/argo_smoke

NEXT_PUBLIC_GATEWAY_URL=http://argo:8080
