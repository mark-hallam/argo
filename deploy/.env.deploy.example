# SKYCOT gated deploy — gateway runtime secrets/config.
# Copy to deploy/.env.deploy, fill in, `chmod 600`. NEVER commit deploy/.env.deploy.
#
# (The SPA demo-mode flags are build-args in docker-compose.yml, not here —
#  they bake into the SPA image at build time.)

# --- LLM / voice provider secrets ---
OPENAI_API_KEY=sk-...            # voice STT/TTS + realtime + any OpenAI provider use
ANTHROPIC_API_KEY=sk-ant-...     # pitch / agent LLM path
# (alternative to ANTHROPIC_API_KEY: ARGO_PITCH_LLM_PROVIDER=claude-code-cli —
#  but an API key is simpler on a headless server)

# --- DB encryption key (32-byte base64; generate: openssl rand -base64 32) ---
SKYCOT_DB_KEY_BASE64=

# --- gateway data dir (persistent volume mount) ---
ARGO_HOME=/data

# The nginx basic-auth GATE is configured separately:
#   htpasswd -c deploy/.htpasswd <gate-username>
# and the TLS certs come from certbot at /etc/letsencrypt (mounted into nginx).
