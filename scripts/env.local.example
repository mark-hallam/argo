# ~/.argo/env.local.example — operator-facing template for env.local.
#
# The auto-bootstrap inside scripts/restart-live-gateway.sh writes a
# file with this exact shape on first run, with real values plugged in.
# Copy this template to ~/.argo/env.local if you prefer to set things
# up manually instead:
#
#     mkdir -p ~/.argo
#     cp scripts/env.local.example ~/.argo/env.local
#     chmod 600 ~/.argo/env.local
#     # ...edit to insert real values...
#
# After editing, source it before launching the gateway:
#
#     source ~/.argo/env.local && make restart-live-gateway
#
# Or just run `make restart-live-gateway` — it auto-sources env.local
# if the file exists.

# 32-byte base64-encoded encryption key for the SQLCipher sessions DB.
# Generate one with:
#
#     openssl rand -base64 32
#
# Verify the value decodes to exactly 32 bytes (44 base64 characters):
#
#     echo "$SKYCOT_DB_KEY_BASE64" | base64 -d | wc -c   # → 32
#
# Losing this key makes sessions.db unreadable forever. Back it up if
# you care about historical sessions.
export SKYCOT_DB_KEY_BASE64='REPLACE_WITH_32_BYTE_BASE64_KEY'

# 32-byte base64-encoded workspace ROOT key. Seeds every per-tenant
# credential master key (HKDF-SHA256 derives one per tenant_id). The
# previous process-global master key was the §3 P0 finding in
# eval-credentials-cross-tenant-isolation (round-9, PR #2080) —
# rotating away from it limits cross-tenant blast radius to a single
# tenant on key compromise.
#
# Generate one with:
#
#     openssl rand -base64 32
#
# Back-compat: if SKYCOT_WORKSPACE_ROOT_KEY_BASE64 is unset, the
# resolver falls back to deriving from ARGO_CREDENTIALS_MASTER_KEY so
# existing single-key deployments keep working without re-onboarding.
# Set this explicitly for any deployment that has more than one
# tenant.
#
# Losing this key makes every per-tenant-encrypted credential
# unrecoverable. Back it up alongside SKYCOT_DB_KEY_BASE64.
export SKYCOT_WORKSPACE_ROOT_KEY_BASE64='REPLACE_WITH_32_BYTE_BASE64_KEY'

# LLM provider key. At least one of ANTHROPIC_API_KEY / OPENAI_API_KEY
# is required for the gateway to serve agent traffic. Rotate by editing
# this line; a running gateway holds the key in memory until restart.
export ANTHROPIC_API_KEY='REPLACE_WITH_ANTHROPIC_API_KEY'
# export OPENAI_API_KEY='sk-...'
