# K5 — End-to-end deployment smoke (CI workflow).
#
# Brings up the K1 docker-compose stack on a fresh runner, runs the
# API-level assertions in `deploy/smoke/checks.ts`, and tears down.
#
# A green run on `main` cuts DEPLOYMENT-PATH DIRECTIVE v3 §5 box 7.
# See `deploy/smoke/README.md` for the full check list and triage
# guide.

name: deploy-smoke

on:
  push:
    branches: [main]
    paths:
      - "crates/**"
      - "deploy/**"
      - "web/**"
      - "Cargo.toml"
      - "Cargo.lock"
      - ".github/workflows/deploy-smoke.yml"
  schedule:
    # Nightly at 04:00 UTC — picks up any non-deterministic drift
    # (image-base CVE refreshes, time-of-day flakes, etc.).
    - cron: "0 4 * * *"
  workflow_dispatch: {}

concurrency:
  # Serialise smoke runs so two main-pushes don't race on
  # localhost:8080 / :3000 inside the same runner pool.
  group: deploy-smoke
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  deploy-smoke:
    name: compose stack + API checks
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          # ubuntu-latest already ships Node 20+; pinning here keeps
          # native `fetch` (used by checks.ts) on a known floor. No
          # npm cache — `deploy/smoke/` has no lock file (deps are
          # ts-node + typescript only, ~7s fresh install) and adding
          # one just to enable cache would be more churn than gain.
          node-version: "20"

      - name: Run smoke (build + up + checks + down)
        timeout-minutes: 15
        run: bash deploy/smoke/run.sh

      - name: Capture compose logs on failure
        if: failure()
        run: |
          docker compose -f deploy/docker/docker-compose.yml \
            --env-file deploy/smoke/.env.smoke \
            logs --no-color > smoke-logs.txt 2>&1 || true

      - name: Upload smoke logs artifact
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: smoke-logs
          path: smoke-logs.txt
          retention-days: 14
          if-no-files-found: ignore

      - name: Ensure teardown
        if: always()
        run: |
          docker compose -f deploy/docker/docker-compose.yml \
            --env-file deploy/smoke/.env.smoke \
            down -v --remove-orphans >/dev/null 2>&1 || true
