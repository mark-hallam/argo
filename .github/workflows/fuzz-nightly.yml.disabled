name: Fuzz nightly
# Nightly 60-second smoke run of every cargo-fuzz target. Each target
# uses libFuzzer (nightly-only) for ~60s, then reports a crash if any
# input panics. Crash artifacts are uploaded for triage.
#
# Disabled until CI billing is restored. Operators rename
# `fuzz-nightly.yml.disabled` → `fuzz-nightly.yml` to activate, same
# pattern as `audit.yml.disabled` / `silent-skip-nightly.yml.disabled`.
#
# Locally:
#   cd crates/argo-audit/fuzz
#   cargo +nightly fuzz run audit_chain_hash -- -max_total_time=60
# Reproducing a crash: see `docs/skycot/RUNBOOK.md` → "Fuzz testing".

on:
  schedule:
    - cron: "0 6 * * *"
  workflow_dispatch:

jobs:
  fuzz:
    name: cargo-fuzz 60s smoke
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        include:
          - crate: argo-audit
            target: audit_chain_hash
          - crate: argo-audit
            target: audit_chain_walk
          - crate: argo-redact
            target: redact_text
          - crate: argo-redact
            target: redact_row
          - crate: argo-genesis
            target: archetype_classify
          - crate: argo-genesis
            target: archetype_from_slug
          - crate: argo-mcp
            target: jsonrpc_request
          - crate: argo-mcp
            target: jsonrpc_response
          - crate: argo-mcp
            target: call_tool_result
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@nightly
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: fuzz-nightly-${{ matrix.crate }}
          workspaces: crates/${{ matrix.crate }}/fuzz
      - name: Install cargo-fuzz
        run: cargo install cargo-fuzz --locked
      - name: Seed corpus from checked-in fixtures
        run: |
          mkdir -p crates/${{ matrix.crate }}/fuzz/corpus/${{ matrix.target }}
          if [ -d "crates/${{ matrix.crate }}/fuzz/seeds/${{ matrix.target }}" ]; then
            cp -n crates/${{ matrix.crate }}/fuzz/seeds/${{ matrix.target }}/* \
              crates/${{ matrix.crate }}/fuzz/corpus/${{ matrix.target }}/ || true
          fi
      - name: Run 60-second smoke
        working-directory: crates/${{ matrix.crate }}/fuzz
        run: cargo +nightly fuzz run ${{ matrix.target }} -- -max_total_time=60
      - name: Upload crash artifacts
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: crash-${{ matrix.crate }}-${{ matrix.target }}
          path: crates/${{ matrix.crate }}/fuzz/artifacts/${{ matrix.target }}
          if-no-files-found: ignore
